# Files that stay in the repo but must not ship in the published skill.
# `clawhub publish` honours this on top of .gitignore.
#
# install-local.ts is the dev-only installer: it reads plow-local-token to POST
# this working copy at plowd. A published skill that reads a local Plow
# credential is rejected by skill-vetter on the user's machine, so shipping it
# blocks the very install it exists to shortcut.
#
# The *.test.ts files and their fixtures DO ship — SKILL.md § Checking your own
# work has the agent run them from the installed bundle.
scripts/install-local.ts
