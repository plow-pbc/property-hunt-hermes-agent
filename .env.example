# The Plow relay credential for this agent, and which Mac it reaches.
# Mint both from the Mac running Plow Latch:
#   POST /v1/relay/agents  (needs relay:device scope, which only the Mac holds)
# The response carries the token and a ready-made mcp_config.
# Never commit real values.
DOMO_MCP_TOKEN=
DOMO_DEVICE_UID=

# Written in place by `agent-mgr activate property`. Do not fill these by hand: the chat uid
# and token are minted together by the activation exchange, and a hand-typed
# pair that does not match will authenticate as nothing.
PLOW_CHAT_CHAT_UID=
PLOW_CHAT_TOKEN=
